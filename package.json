{
  "name": "candidate-data-transformer",
  "version": "1.0.0",
  "description": "CLI that merges recruiter CSV and GitHub data into one canonical, provenance-tracked profile per candidate",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "candidate-transformer": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "typecheck": "tsc && tsc -p web",
    "lint": "eslint .",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run coverage",
    "benchmark": "tsx scripts/benchmark.ts",
    "eval:resumes": "tsx scripts/eval-resumes.ts",
    "fixtures:resumes": "tsx scripts/make-resume-fixtures.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "concurrently -k -n api,web -c green,gray \"node --watch --import tsx src/server/main.ts --port 8787\" \"vite --config web/vite.config.ts\"",
    "dev:api": "node --watch --import tsx src/server/main.ts --port 8787",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:replay": "concurrently -k -n api,web -c green,gray \"node --watch --import tsx src/server/main.ts --port 8787 --replay\" \"vite --config web/vite.config.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@hono/node-server": "2.1.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "hono": "4.13.17",
    "libphonenumber-js": "^1.11.9",
    "mammoth": "1.13.0",
    "p-limit": "^7.3.0",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "10.0.7",
    "docx": "9.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "28.1.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
